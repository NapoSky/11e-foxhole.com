{
  "name": "11e-foxhole",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "build": "yarn compile && yarn next build --webpack",
    "clean": "rm -rf build-tsc .next",
    "compile": "yarn run -T tsc --build --verbose",
    "dev": "yarn compile && yarn next dev --webpack",
    "lint": "yarn run -T prettier --write './src/**/*.{js,jsx,json,ts,tsx}' && eslint './src/**/*.{js,jsx,ts,tsx}' --fix --max-warnings=0 --format=json > /dev/null",
    "start": "yarn next start",
    "sitemap": "yarn next-sitemap",
    "test": "playwright test",
    "test:headed": "playwright test --headed",
    "test:staging": "BASE_URL=https://stgsite.11e-foxhole.com playwright test"
  },
  "dependencies": {
    "@headlessui/react": "^2.2.10",
    "@heroicons/react": "^2.2.0",
    "@tailwindcss/forms": "^0.5.11",
    "@tailwindcss/postcss": "^4.3.0",
    "@tailwindcss/typography": "^0.5.19",
    "@types/node": "25.8.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "autoprefixer": "^10.5.0",
    "classnames": "^2.5.1",
    "country-flag-icons": "^1.6.17",
    "cssnano": "^8.0.1",
    "fs-extra": "^11.3.5",
    "i18next": "^26.2.0",
    "i18next-browser-languagedetector": "^8.2.1",
    "next": "^16.2.6",
    "next-i18next": "^16.0.6",
    "next-images": "^1.8.5",
    "next-sitemap": "^4.2.3",
    "postcss": "^8.5.14",
    "postcss-preset-env": "^11.3.0",
    "prettier": "^3.8.3",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "react-i18next": "^17.0.8",
    "sass": "^1.99.0",
    "tailwindcss": "^4.3.0",
    "typescript": "^6.0.3"
  },
  "resolutions": {
    "string-width": "^7.1.2",
    "string-width-cjs": "^5.1.1",
    "strip-ansi": "^7.0.1",
    "strip-ansi-cjs": "^8.0.0"
  },
  "devDependencies": {
    "@next/eslint-plugin-next": "^16.2.6",
    "@playwright/test": "^1.60.0",
    "@types/eslint": "^9.6.1",
    "@typescript-eslint/eslint-plugin": "^8.59.3",
    "@typescript-eslint/parser": "^8.59.3",
    "eslint": "^10.4.0",
    "eslint-plugin-prettier": "^5.5.5",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "webpack": "^5.106.2"
  },
  "packageManager": "yarn@4.12.0"
}
