{
  "name": "11e-foxhole",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "preinstall": "node scripts/check-package-manager.cjs",
    "build": "pnpm run compile && next build --webpack",
    "clean": "node scripts/clean.cjs",
    "compile": "tsc --build --verbose",
    "dev": "pnpm run compile && next dev --webpack",
    "lint": "eslint './src/**/*.{js,jsx,ts,tsx}' --max-warnings=0",
    "lint:fix": "prettier --write './src/**/*.{js,jsx,json,ts,tsx}' && pnpm run lint --fix",
    "lint:workflows": "prettier --check '.github/**/*.{yml,yaml}' pnpm-workspace.yaml",
    "start": "pnpm run preview",
    "preview": "serve out --listen 3000",
    "sitemap": "next-sitemap",
    "test:tooling": "node --test scripts/*.test.cjs",
    "test": "playwright test",
    "test:headed": "playwright test --headed",
    "test:staging": "BASE_URL=https://stgsite.11e-foxhole.com playwright test"
  },
  "dependencies": {
    "@headlessui/react": "^2.2.10",
    "@heroicons/react": "^2.2.0",
    "@tailwindcss/forms": "^0.5.11",
    "@tailwindcss/postcss": "^4.3.3",
    "@tailwindcss/typography": "^0.5.20",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "autoprefixer": "^10.6.2",
    "classnames": "^2.5.1",
    "country-flag-icons": "^1.6.20",
    "cssnano": "^9.9.0",
    "fs-extra": "^11.4.1",
    "i18next": "^26.5.12",
    "i18next-browser-languagedetector": "^8.2.4",
    "next": "^16.4.3",
    "next-i18next": "^16.4.5",
    "next-images": "^1.8.5",
    "next-sitemap": "^4.2.3",
    "postcss": "^8.5.32",
    "postcss-preset-env": "^11.6.2",
    "prettier": "^3.9.10",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-i18next": "^17.1.9",
    "sass": "^1.107.1",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3"
  },
  "devDependencies": {
    "@next/eslint-plugin-next": "^16.4.3",
    "@playwright/test": "^1.64.1",
    "@types/eslint": "^9.6.1",
    "@typescript-eslint/eslint-plugin": "^8.72.1",
    "@typescript-eslint/parser": "^8.72.1",
    "eslint": "^10.14.0",
    "eslint-plugin-prettier": "^5.5.7",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "serve": "14.2.6",
    "webpack": "^5.112.2"
  },
  "packageManager": "pnpm@12.16.1",
  "engines": {
    "node": ">=24.22.2 <25",
    "pnpm": "12.16.1"
  }
}
