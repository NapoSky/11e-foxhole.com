{
  "compilerOptions": {
    "target": "ES2022",
    "module": "commonjs",
    "lib": ["ES2022"],
    "strict": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "resolveJsonModule": true,
    "baseUrl": "../",
    "paths": {
      "@/*": ["../src/*"]
    }
  },
  "include": ["**/*.ts", "../playwright.config.ts"],
  "exclude": ["../node_modules"]
}
